SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional (preferred for server-side tools):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional (recommended for SQL chat agent):
# DATABASE_URL=postgresql://postgres.<project_ref>:<db_password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Needed only for direct PostgreSQL operations (schema/setup scripts):
SUPABASE_DB_PASSWORD=your_database_password
# Optional fallback pieces for SQL chat agent when DATABASE_URL is not set:
SUPABASE_DB_HOST=aws-0-us-west-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.<project_ref>
OPENAI_API_KEY=sk-...
OPENAI_MARKETING_MODEL=gpt-5.4

# Fathom (Settings > API)
FATHOM_API_KEY=fth_...
FATHOM_TEAM_FILTER=Account Executives

# HubSpot (Settings > Integrations > Private Apps)
HUBSPOT_API_KEY=pat-...

# Optional
TRANSCRIPT_VIEW_NAME=v_transcripts
OPENAI_MODEL=gpt-4o-mini
INSIGHTS_COPILOT_MODEL=gpt-4o-mini
INSIGHTS_COPILOT_SUMMARY_MODEL=gpt-4o-mini
BATCH_POLL_INTERVAL=60
MAX_TOKENS_PER_CHUNK=12000
PROMPT_VERSION=v2.0

# ─── Monitoreo de competidores + Content Discovery (humand-insights-web) ─────
# Estas viven en el service de Railway, no en el pipeline Python. Se documentan
# acá porque no estaban en ningún lado y hay que setearlas a mano al provisionar.

# Ad libraries: Meta / LinkedIn / Google Ads Transparency
SCRAPECREATORS_API_KEY=
# Instagram: perfiles, hashtags y búsqueda
APIFY_API_KEY=
# Default: COMPETITOR_ADS_MODEL -> ASK_CHART_MODEL -> gpt-4o-mini
COMPETITOR_ADS_MODEL=
# whisper-1 acepta el contenedor mp4; los gpt-4o-*-transcribe lo rechazan.
COMPETITOR_ADS_TRANSCRIBE_MODEL=whisper-1

# Secreto compartido para /api/internal/* (service-to-service con humand-content).
# Generar con: openssl rand -hex 32
CONTENT_ENGINE_TOKEN=
